# Copy to .env for local dev. On Vercel set these in Project Settings → Environment Variables.
# NEVER commit real values.
TELEGRAM_BOT_TOKEN=
FACEBOOK_ACCESS_TOKEN=
GOOGLE_SHEET_URL=
# Long random string; must equal SHEET_SECRET in Apps Script → Project Settings → Script Properties
GOOGLE_SHEET_SECRET=
# Long random string; passed as secret_token when calling Telegram setWebhook
TELEGRAM_WEBHOOK_SECRET=
# Password for the ads.html dashboard
DASHBOARD_PASSWORD=
